<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercício 1</title>
    <style>
        canvas { border: 1px solid black; background: black; cursor: crosshair; }
    </style>
</head>
<body>
    <canvas id="canvasEx1" width="800" height="600"></canvas>
    <script>
        const canvas = document.getElementById("canvasEx1");
        const ctx = canvas.getContext("2d");

        const cores = ["white", "blue", "red", "green", "yellow", "cyan", "magenta", "orange", "purple", "gray"];
        let corAtual = 1; // Azul
        let cliques = [];

        function plotPixel(x, y, cor) {
            ctx.fillStyle = cores[cor];
            ctx.fillRect(x, y, 1, 1);
        }

        function bresenham(x1, y1, x2, y2, cor) { 
            let dx = Math.abs(x2 - x1);
            let dy = Math.abs(y2 - y1);
            let sx = (x1 < x2) ? 1 : -1;
            let sy = (y1 < y2) ? 1 : -1;
            let erro = dx - dy;

            while (true) {
                plotPixel(x1, y1, cor);
                if (x1 === x2 && y1 === y2) break;
                let e2 = 2 * erro;
                if (e2 > -dy) { erro -= dy; x1 += sx; }
                if (e2 < dx) { erro += dx; y1 += sy; }
            }
        }

        canvas.addEventListener("mousedown", (e) => { 
            const rect = canvas.getBoundingClientRect();
            cliques.push({ x: Math.round(e.clientX - rect.left), y: Math.round(e.clientY - rect.top) });
            
            if (cliques.length === 2) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                bresenham(cliques[0].x, cliques[0].y, cliques[1].x, cliques[1].y, corAtual);
                cliques = [];
            }
        });

        window.addEventListener("keydown", (e) => {
            if (e.key >= '0' && e.key <= '9') {
                corAtual = parseInt(e.key);
            }
        });

        bresenham(0, 0, 0, 0, 1);
    </script>
</body>
</html>
